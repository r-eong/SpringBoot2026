<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-config.dtd">

<!-- configuration : 전역 환경설정 - 에디에서나 사용 가능 -->
<configuration>
<!-- 별칭을 작성하는 명령어 태그 - typeAliases -->
	<typeAliases>
		<typeAlias alias="MemberDTO" type="com.green.member.MemberDTO" />
		<typeAlias alias="BoardDTO" type="com.green.board.BoardDTO" />
		<!-- alias="MemberDTO" <- 이게 별칭 -->
	</typeAliases>
	
	<!-- <mappers>
		<mapper resource="mybatis.mappers.member-mapper.xml" />
		application.properties 에 작성한 
		mybatis.mapper-locations=classpath:mybatis/mappers/*.xml 과 같은 기능이지만 
		파일을만들 때 마다 추가해주어야함!
	</mappers> -->
</configuration>