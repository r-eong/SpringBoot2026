<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.green.member.mapper.MemberMapper">
	<!-- 회원가입 - 회원 추가 메소드
	public int addMember(MemberDTO mdto); -->
	<insert id="addMember" parameterType="MemberDTO">
		INSERT INTO member_table(id, pw, mail, phone) 
		VALUES(#{id}, #{pw}, #{mail}, #{phone})
	</insert>
	
	<!-- 회원가입 - 아이디 중복체크
	public boolean isMember(String id); -->
	<select id="isMember" resultType="boolean" parameterType="String">
		SELECT COUNT(*) FROM member_table WHERE id=#{id}
	</select>
	
	
	<!-- 관리자 - 회원 전체목록
	public List<MemberDTO> allMember(); -->
	<select id="allMember" resultType="MemberDTO">
		SELECT * FROM member_table 
	</select>
	
	<!-- 유저 1명의 상세 정보
	public MemberDTO oneMember(String id); -->
	<select id="oneMember" resultType="MemberDTO" parameterType="String">
		SELECT * FROM member_table WHERE id=#{id}
	</select>
	
	<!-- 유저 1명의 정보 수정
	public int updateMember(MemberDTO mdto); -->
	<update id="updateMember" parameterType="MemberDTO">
		UPDATE member_table SET mail=#{mail}, phone=#{phone} WHERE id=#{id}
	</update>
	
	<!-- 유저 1명의 비밀번호 리턴
	public String getPw(String id); -->
	<select id="getPw" resultType="String" parameterType="String">
		SELECT pw FROM member_table WHERE id=#{id}
	</select>
	
	<!-- 유저 1명 삭제
	public int delMember(String id); -->
	<delete id="delMember" parameterType="String">
		DELETE FROM member_table WHERE id=#{id}
	</delete>
</mapper>
